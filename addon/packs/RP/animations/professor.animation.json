{
  "format_version": "1.8.0",
  "animations": {
    "animation.censor.look_at_target": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": ["query.target_x_rotation", "query.target_y_rotation", 0]
        }
      }
    },
    "animation.censor.walk": {
      "loop": true,
      "bones": {
        "rightLeg": {
          "rotation": ["math.cos(query.modified_distance_moved * 38.17) * 35.0 * math.min(1.0, query.modified_move_speed * 4.0)", 0, 0]
        },
        "leftLeg": {
          "rotation": ["-math.cos(query.modified_distance_moved * 38.17) * 35.0 * math.min(1.0, query.modified_move_speed * 4.0)", 0, 0]
        },
        "leftArm": {
          "rotation": ["math.cos(query.modified_distance_moved * 38.17) * 20.0 * math.min(1.0, query.modified_move_speed * 4.0)", 0, 0]
        }
      }
    },
    "animation.censor.point": {
      "loop": true,
      "bones": {
        "rightArm": {
          "rotation": ["-74.0 + math.sin(query.life_time * 110.0) * 4.0", "8.0 + math.sin(query.life_time * 70.0) * 3.0", 0]
        },
        "stick": {
          "rotation": ["-12.0", 0, 0]
        }
      }
    },
    "animation.censor.nod": {
      "loop": false,
      "animation_length": 1.2,
      "bones": {
        "head": {
          "rotation": {
            "0.0": [0, 0, 0],
            "0.2": [18, 0, 0],
            "0.4": [-6, 0, 0],
            "0.6": [18, 0, 0],
            "0.8": [-6, 0, 0],
            "1.2": [0, 0, 0]
          }
        }
      }
    },
    "animation.censor.shake": {
      "loop": false,
      "animation_length": 1.2,
      "bones": {
        "head": {
          "rotation": {
            "0.0": [0, 0, 0],
            "0.2": [0, 22, 0],
            "0.5": [0, -22, 0],
            "0.8": [0, 22, 0],
            "1.2": [0, 0, 0]
          }
        }
      }
    }
  }
}
