{
  "format_version": "1.21.100",
  "minecraft:entity": {
    "description": {
      "identifier": "censor:professor",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "censor:commuting": {
        "minecraft:behavior.move_to_block": {
          "priority": 1,
          "tick_interval": 20,
          "start_chance": 1.0,
          "search_range": 40,
          "search_height": 12,
          "goal_radius": 2.5,
          "stay_duration": 1.0,
          "target_selection_method": "nearest",
          "target_offset": [0, 0, 0],
          "target_blocks": ["censor:whiteboard"],
          "speed_multiplier": 1.0
        }
      },
      "censor:idle": {
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "interval": 260,
          "xz_dist": 3,
          "y_dist": 1,
          "speed_multiplier": 0.55
        }
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["censor", "professor", "mob"] },
      "minecraft:collision_box": { "width": 0.6, "height": 1.9 },
      "minecraft:health": { "value": 20, "max": 20 },
      "minecraft:damage_sensor": {
        "triggers": [{ "cause": "all", "deals_damage": "no" }]
      },
      "minecraft:fire_immune": {},
      "minecraft:knockback_resistance": { "value": 1.0 },
      "minecraft:persistent": {},
      "minecraft:nameable": { "always_show": true, "allow_name_tag_renaming": false },
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0, "breathes_water": true },
      "minecraft:movement": { "value": 0.5 },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "can_pass_doors": true,
        "can_open_doors": true,
        "avoid_water": true
      },
      "minecraft:annotation.open_door": {},
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.look_at_player": {
        "priority": 4,
        "look_distance": 6.0,
        "probability": 0.9
      },
      "minecraft:behavior.random_look_around": { "priority": 8 }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["censor:commuting"] }
      },
      "censor:start_commute": {
        "remove": { "component_groups": ["censor:idle"] },
        "add": { "component_groups": ["censor:commuting"] }
      },
      "censor:arrive": {
        "remove": { "component_groups": ["censor:commuting"] },
        "add": { "component_groups": ["censor:idle"] }
      }
